# ===================================================================
# Конфигурация окружения для Campus BGPU API (Шаблон)
# Переименуйте этот файл в .env и подставьте свои актуальные ключи
# ===================================================================

# Секретный ключ для подписи и валидации JWT (минимум 256 бит / 32 символа)
BGPU_ACCESS_SECRET_KEY=your_super_secret_key_at_least_32_characters_long_here

# Интеграционные URL-адреса внешних API БГПУ
BGPU_USER_API_URL=https://edu28.ru
BGPU_POINTS_API_URL=https://edu28.ru

# Настройки базы данных (если планируете переопределять вне docker-compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://campus-db:5432/campus_booking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
